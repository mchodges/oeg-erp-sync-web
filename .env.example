# Airtable personal access token
# Create one at: https://airtable.com/create/tokens
# Required scopes: data.records:read  data.records:write
AIRTABLE_API_KEY=pat...

# ── Bid Pricing Estimator ────────────────────────────────────────────────
# Anthropic API key for AI-assisted line-item matching
# Create one at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Supabase project (stores the append-only bid-history line items)
# Settings → API in your Supabase project dashboard
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# A separate Airtable base ("Bid Pricing") holding Master_Catalog and
# Living_Matches tables. Make sure your AIRTABLE_API_KEY token's scope
# includes this base (PATs are often scoped to specific bases).
PRICING_BASE_ID=appXXXXXXXXXXXXXX
MASTER_CATALOG_TABLE_ID=tblXXXXXXXXXXXXXX
LIVING_MATCHES_TABLE_ID=tblXXXXXXXXXXXXXX
